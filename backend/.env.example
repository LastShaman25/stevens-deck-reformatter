# Shared configuration template, synchronized with the local backend/.env.
# Copy this file to backend/.env and add your own credentials.
# Never commit or share backend/.env. API credentials are intentionally omitted.
# Active non-secret values below match the current local configuration.
# Direct OpenAI is selected; planner, generator and reviewer use gpt-6-luna.
# Zero for the cumulative call/token settings means no app spending cap.

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ANTHROPIC_MODEL=claude-sonnet-4-5
STEVENS_AI_MAX_CALLS=0
STEVENS_OFFLINE=0
STEVENS_LEARN=0
AI_GATEWAY_API_KEY=your_ai_gateway_api_key
STEVENS_AI_PROVIDER=openai
STEVENS_AI_REVIEWER_MODEL=gpt-6-luna
AI_GATEWAY_REASONING_EFFORT=low
AI_GATEWAY_REVIEW_REASONING_EFFORT=low
STEVENS_AI_MAX_TOKENS=0
STEVENS_AI_REVIEWER=openai
STEVENS_AI_REDESIGNER=openai
STEVENS_AI_GENERATOR=openai
STEVENS_AI_REDESIGNER_MODEL=gpt-6-luna
STEVENS_AI_GENERATOR_MODEL=gpt-6-luna
AI_GATEWAY_REDESIGN_REASONING_EFFORT=low
AI_GATEWAY_GENERATOR_REASONING_EFFORT=low
OPENAI_API_KEY=your_openai_api_key
STEVENS_AI_PLANNER=openai
STEVENS_AI_MODEL=gpt-6-luna
STEVENS_AI_PLANNER_MODEL=gpt-6-luna
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_REVIEW_REASONING_EFFORT=low

# Optional server settings (uncomment and configure as needed):
# STEVENS_AUTH_MODE=invitation
# STEVENS_ADMIN_CODE=choose_a_private_invitation_code
# STEVENS_PUBLIC_URL=http://localhost:8000
# STEVENS_AUTH_DB=
# STEVENS_OIDC_ISSUER=
# STEVENS_OIDC_CLIENT_ID=
# STEVENS_OIDC_CLIENT_SECRET=
# STEVENS_INITIAL_ADMIN_EMAIL=
# STEVENS_AI_REQUEST_TIMEOUT=180
