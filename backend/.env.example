# Copy to backend/.env and configure keys locally. Never commit or share .env.
# Real environment variables override nonempty file values. New AI settings reload
# on each request; the health/configuration panel never exposes key values.
# Every workflow requires AI and completed QA. Keys stay on the server.
# Recommended Vercel AI Gateway configuration (also works on a non-Vercel host).
AI_GATEWAY_API_KEY=
STEVENS_AI_PROVIDER=vercel
STEVENS_AI_PLANNER_MODEL=anthropic/claude-sonnet-5.5
STEVENS_AI_REVIEWER_MODEL=anthropic/claude-opus-5.5-fast
AI_GATEWAY_REASONING_EFFORT=low
AI_GATEWAY_REVIEW_REASONING_EFFORT=medium
# Optional common model. Clear the two role model settings to use it for both.
STEVENS_AI_MODEL=
# Optional provider overrides per role; blank inherits STEVENS_AI_PROVIDER.
STEVENS_AI_PLANNER=
STEVENS_AI_REVIEWER=

# Direct providers are retained for an explicit switch/rollback. To use them,
# set STEVENS_AI_PROVIDER and clear Gateway model overrides above.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Keep planning inexpensive; visual reviewers use low reasoning for identity checks.
OPENAI_REASONING_EFFORT=none
OPENAI_REVIEW_REASONING_EFFORT=low

# Optional alternative providers; never used as automatic failure fallbacks.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ANTHROPIC_MODEL=claude-sonnet-4-5

# Supported providers: vercel, openai, anthropic, gemini, auto.
# Explicit auto prefers a configured Gateway, then OpenAI and direct alternatives.
# Failures never silently switch to a different model.
# Maximum outbound requests per generation, including repair/review attempts.
STEVENS_AI_MAX_CALLS=160
# No provider calls when set to 1. Automated tests use this setting.
STEVENS_OFFLINE=0
# Automatic learning remains disabled.
STEVENS_LEARN=0

# Sign-in now uses account-bound invitation codes. The first administrator code
# is admin as requested; administrators can replace it and generate member codes.
# Changing this bootstrap setting does not reset codes in an existing database.
STEVENS_AUTH_MODE=invitation
STEVENS_ADMIN_CODE=admin
STEVENS_PUBLIC_URL=http://localhost:8000
# Optional account database path; default is local app data, outside the repository.
STEVENS_AUTH_DB=
# Google OIDC can be enabled later by changing AUTH_MODE to oidc.
STEVENS_OIDC_ISSUER=https://accounts.google.com
STEVENS_OIDC_CLIENT_ID=
STEVENS_OIDC_CLIENT_SECRET=
STEVENS_INITIAL_ADMIN_EMAIL=
# Cumulative budget per temporary processing job, including output QA.
STEVENS_AI_MAX_TOKENS=500000

# Per-request read timeout (seconds, 30-300); transport failures retry once within upload budget.
STEVENS_AI_REQUEST_TIMEOUT=180
