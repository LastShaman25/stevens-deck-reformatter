# Copy to backend/.env and configure keys locally. Never commit or share .env.
# Real environment variables override nonempty file values. New AI settings reload
# on each request; the health/configuration panel never exposes key values.
# Keys are required for AI mode; preservation mode remains usable without them.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# No hidden reasoning budget by default for inexpensive development checks.
OPENAI_REASONING_EFFORT=none

# Optional alternative providers; never used as automatic failure fallbacks.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ANTHROPIC_MODEL=claude-sonnet-4-5

# Separate planning/review calls both use GPT-6 Luna with one OpenAI key.
# Supported selections: openai, anthropic, gemini, auto.
# Explicit auto prefers OpenAI, then the configured legacy provider(s).
STEVENS_AI_PLANNER=openai
STEVENS_AI_REVIEWER=openai
# Maximum outbound requests per generation, including repair/review attempts.
STEVENS_AI_MAX_CALLS=160
# No provider calls when set to 1. Automated tests use this setting.
STEVENS_OFFLINE=0
# Automatic learning remains disabled.
STEVENS_LEARN=0

# Sign-in now uses account-bound invitation codes. The first administrator code
# is admin as requested; administrators can replace it and generate member codes.
# Changing this bootstrap setting does not reset codes in an existing database.
STEVENS_AUTH_MODE=invitation
STEVENS_ADMIN_CODE=admin
STEVENS_PUBLIC_URL=http://localhost:8000
# Optional account database path; default is local app data, outside the repository.
STEVENS_AUTH_DB=
# Google OIDC can be enabled later by changing AUTH_MODE to oidc.
STEVENS_OIDC_ISSUER=https://accounts.google.com
STEVENS_OIDC_CLIENT_ID=
STEVENS_OIDC_CLIENT_SECRET=
STEVENS_INITIAL_ADMIN_EMAIL=
# Cumulative budget per temporary processing job, including output QA.
STEVENS_AI_MAX_TOKENS=500000
