{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [{"source": "/(.*)", "destination": "/index.html"}]
    },
    "backend": {
      "root": "backend",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel",
      "functions": {"Dockerfile.vercel": {"maxDuration": 800, "memory": 4096}}
    }
  },
  "rewrites": [
    {"source": "/api/:path*", "destination": {"service": "backend"}},
    {"source": "/auth/:path*", "destination": {"service": "backend"}},
    {"source": "/:path*", "destination": {"service": "frontend"}}
  ],
  "crons": [{"path": "/api/cloud/tick", "schedule": "* * * * *"}]
}
